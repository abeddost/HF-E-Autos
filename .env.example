# ─────────────────────────────────────────────────────────────
# HF E-Autos — environment variables
# Copy to .env.local for local development. Set the same keys in
# the Vercel project settings for production.
# ─────────────────────────────────────────────────────────────

# Public site URL (used for absolute URLs, OG tags, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── mobile.de Seller API ─────────────────────────────────────
# Basic-Auth credentials for the mobile.de Seller API user.
MOBILE_DE_USERNAME=""
MOBILE_DE_PASSWORD=""
# The :mobileSellerId path segment — your mobile.de Kundennummer.
MOBILE_DE_SELLER_ID="879460"

# ── Durable storage for the synced inventory ─────────────────
# Provide ONE of the following groups. If none are set, the sync
# falls back to a local JSON file at data/vehicles.json (dev only).
#
# Vercel KV / Upstash Redis (REST):
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
# …or the Upstash-native names:
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
# …or a plain Redis connection string:
# REDIS_URL=""

# ── Sync endpoint auth ───────────────────────────────────────
# Shared secret for manually triggering POST/GET /api/sync-vehicles.
SYNC_SECRET=""
# Set by Vercel Cron automatically in production — add it in the
# Vercel dashboard so the daily cron call is authenticated.
CRON_SECRET=""

# ── Contact form (Resend) ────────────────────────────────────
# If RESEND_API_KEY is empty the contact form is disabled and the
# UI shows phone / e-mail fallbacks instead.
RESEND_API_KEY=""
CONTACT_TO_EMAIL="info@hf-eautos.de"
CONTACT_FROM_EMAIL="Website <website@hf-eautos.de>"
